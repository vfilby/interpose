# Paperless adapter settings: copy to .env beside compose.yaml. Real host names go there, never in the repository.
TZ=UTC
# The adapter id registered at the hub.
ADAPTER_ID=paperless
# The hub's address as phones see it (the reverse proxy sends /v1/* to the hub API).
HUB_URL=https://interpose-hub.home.example
# Paperless's API as the adapter reaches it (inside the Paperless stack's network, not through the reverse proxy).
PAPERLESS_URL=http://paperless:8000
# Paperless as people open it: the links the gateway hands back point there.
PAPERLESS_PUBLIC_URL=https://paperless.home.example
# The API token of the adapter's own Paperless user (add documents; view documents, tags, correspondents, document
# types, tasks). Mounted read-only from secrets/paperless-token.
PAPERLESS_TOKEN_FILE=/run/secrets/paperless-token
# Where the agents' gateway listens inside the container (compose publishes nothing; the reverse proxy reaches it).
LISTEN=:8750
# A lease an agent asks for without a duration gets this one; it may ask for up to MAX_LEASE.
DEFAULT_LEASE=1h
MAX_LEASE=24h
# Documents a lease may read (content or file) when the agent names no max_documents. 0 in an ask means unlimited;
# the phone shows it as a warning.
MAX_DOCUMENTS=20
# The largest upload accepted, in MiB.
MAX_UPLOAD_MB=100
# How long a lease request waits for a phone before it is denied (fail closed). Agents usually wait in their own tool
# call, so keep it short.
REQUEST_TTL=15m
